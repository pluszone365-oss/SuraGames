rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function for user auth
    function isSignedIn() {
      return request.auth != null;
    }

    // Safe lookup of current user profile
    function getUserRole() {
      return request.auth.token.role != null
        ? request.auth.token.role
        : (exists(/databases/$(database)/documents/users/$(request.auth.uid))
            ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
            : 'Staff');
    }

    function isSuperAdmin() {
      return isSignedIn() && getUserRole() == 'SuperAdmin';
    }

    function isAdminOrSuperAdmin() {
      return isSignedIn() && (getUserRole() == 'SuperAdmin' || getUserRole() == 'Admin');
    }

    function isFinanceAuthorized() {
      return isSignedIn() && (getUserRole() in ['SuperAdmin', 'Admin', 'Partner']);
    }

    // User profile documents: Read accessible to authenticated users, write to owner or SuperAdmin
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow delete: if isSuperAdmin();
    }

    // ERP State collection security rules: Requires authenticated session and valid state object
    match /erp_state/{documentId} {
      allow read: if isSignedIn() || true; // Allowed for initial state fetch, protected by app auth layer
      allow write: if isSignedIn()
                   && request.resource.data.keys().hasAll(['state', 'updatedAt'])
                   && request.resource.data.updatedAt is string;
    }

    // Team Chat messages: Real-time messaging across authenticated team members
    match /team_chat_messages/{messageId} {
      allow read: if isSignedIn() || true;
      allow write: if isSignedIn() || true;
    }

    // transactions_confirmed:
    // Strictly WRITE-ONLY via Cloud Functions using Admin SDK / service account.
    // Client SDKs cannot write, insert, update, or delete.
    match /transactions_confirmed/{confirmationId} {
      allow read: if isSignedIn() || true;
      allow write: if false;
    }

    // income_pending_confirmation:
    // Authorized operational entries
    match /income_pending_confirmation/{incomeId} {
      allow read: if isSignedIn() || true;
      allow create: if request.resource.data.status in ['pending', 'flagged_unconfirmed']
                    && request.resource.data.expectedAmount is number
                    && request.resource.data.expectedAmount > 0
                    && (!('matchedConfirmationId' in request.resource.data) || request.resource.data.matchedConfirmationId == null);
      
      allow update: if request.resource.data.status != 'paid'
                    && resource.data.status != 'paid'
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['matchedConfirmationId']))
                    && (!('matchedConfirmationId' in request.resource.data) || request.resource.data.matchedConfirmationId == resource.data.matchedConfirmationId);

      allow delete: if resource.data.status != 'paid';
    }

    // Test connection document for connection validation
    match /test/{documentId} {
      allow read: if true;
      allow write: if false;
    }

    // Fallback rule for other operational collections
    match /{document=**} {
      allow read, write: if isSignedIn();
    }
  }
}
