{
  "id": "/",
  "short_name": "PlusZone ERP",
  "name": "Plus Game Zone — Finance & ERP System",
  "description": "Mobile-first PlayStation House & Game Zone management system — cash, Telebirr, CBE, gaming station tracking, Equb, and finance.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "background_color": "#0A0E1A",
  "theme_color": "#00D4AA",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "orientation": "portrait",
  "categories": ["finance", "business", "productivity"],
  "iarc_rating_id": "e84b072d-71b3-4d3e-86ae-31a8ce4e53b7",
  "icons": [
    {
      "src": "/pwa-192.png",
      "type": "image/png",
      "sizes": "192x192",
      "purpose": "any"
    },
    {
      "src": "/pwa-512.png",
      "type": "image/png",
      "sizes": "512x512",
      "purpose": "any"
    },
    {
      "src": "/pwa-maskable-192.png",
      "type": "image/png",
      "sizes": "192x192",
      "purpose": "maskable"
    },
    {
      "src": "/pwa-maskable-512.png",
      "type": "image/png",
      "sizes": "512x512",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "New Transaction",
      "short_name": "New Tx",
      "description": "Log cash or digital payment quickly",
      "url": "/?shortcut=transaction",
      "icons": [
        {
          "src": "/pwa-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Gaming Stations",
      "short_name": "Stations",
      "description": "View active PS5 timers & stations",
      "url": "/?shortcut=gaming",
      "icons": [
        {
          "src": "/pwa-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Wallets & CBE",
      "short_name": "Wallets",
      "description": "Check CBE, Telebirr & eBirr balances",
      "url": "/?shortcut=wallets",
      "icons": [
        {
          "src": "/pwa-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "file_handlers": [
    {
      "action": "/?action=open-file",
      "name": "PlusZone Financial & Ledger Files",
      "accept": {
        "application/json": [".json"],
        "text/csv": [".csv"],
        "text/plain": [".txt"],
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": [".xlsx"]
      },
      "icons": [
        {
          "src": "/pwa-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    }
  ],
  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  },
  "protocol_handlers": [
    {
      "protocol": "web+pluszone",
      "url": "/?protocol_url=%s"
    },
    {
      "protocol": "web+equb",
      "url": "/?equb_url=%s"
    },
    {
      "protocol": "web+telebirr",
      "url": "/?payment_url=%s"
    }
  ],
  "share_target": {
    "action": "/?action=share-target",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "related_applications": [
    {
      "platform": "webapp",
      "url": "/manifest.json",
      "id": "com.pluszone.finance.app"
    }
  ],
  "prefer_related_applications": false,
  "widgets": [
    {
      "name": "PlusZone Live Financial Summary",
      "short_name": "Summary",
      "description": "Daily game lounge revenue, CBE & Telebirr balances, and active stations",
      "tag": "pluszone-finance-widget",
      "template": "widget-summary",
      "ms_ac_template": "/widgets/summary.json",
      "data": "/api/pwa/widget-data",
      "type": "application/json",
      "screenshots": [
        {
          "src": "/pwa-512.png",
          "sizes": "512x512",
          "label": "PlusZone ERP Financial Board"
        }
      ],
      "icons": [
        {
          "src": "/pwa-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "edge_side_panel": {
    "preferred_width": 480
  },
  "note_taking": {
    "new_note_url": "/?action=new-note"
  },
  "scope_extensions": [
    {
      "origin": "https://ais-dev-cmzxjxoqayl4lgqgu3fd7m-316110543649.europe-west2.run.app"
    },
    {
      "origin": "https://ais-pre-cmzxjxoqayl4lgqgu3fd7m-316110543649.europe-west2.run.app"
    }
  ]
}
